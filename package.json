{
  "name": "lightning-replay-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local studio that turns timestamped lightning-strike datasets into geographically accurate, time-compressed replay videos (HyperFrames).",
  "scripts": {
    "start": "node server.js",
    "render": "node scripts/render.js",
    "sample": "node scripts/generate-sample.js",
    "basemap": "node scripts/build-basemap.js",
    "test": "node --test tests/*.test.js",
    "test:map": "node --test tests/map.test.js",
    "test:render": "node --test tests/render.test.js",
    "test:formats": "node --test tests/formats.test.js",
    "test:sound": "node --test tests/sound.test.js"
  },
  "devDependencies": {
    "hyperframes": "0.8.226",
    "node-web-audio-api": "2.2.0"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.6",
    "@fontsource/jetbrains-mono": "5.2.6",
    "gsap": "3.13.0",
    "maplibre-gl": "^6.16.0",
    "puppeteer-core": "^25.16.0",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
